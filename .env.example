# Porta do servidor HTTP local (padrão: 3010)
PORT=3010

# Caminho opcional para o banco SQLite local (padrão: ./data/sorteiofc.db)
# SORTEIOFC_DB_PATH=./data/sorteiofc.db

# Banco Postgres externo (obrigatório na Vercel para persistir as salas; ex.: Neon Postgres gratuito)
# DATABASE_URL=postgres://usuario:senha@host/banco?sslmode=verify-full

# Origem permitida para CORS (opcional, útil apenas se frontend e backend rodarem em origens diferentes)
# CORS_ORIGIN=
