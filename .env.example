# PIN do organizador na criação inicial do banco (defina um código com no mínimo 3 caracteres).
# Se ficar vazio em ambiente local, um PIN aleatório será gerado no terminal na primeira execução.
ADMIN_PIN=

# Porta do servidor HTTP local (padrão: 3010)
PORT=3010

# Caminho opcional para o arquivo do banco SQLite
# TIRATIME_DB_PATH=./data/tiratime.db

# Origem permitida para CORS (opcional, útil apenas se frontend e backend rodarem em origens diferentes)
# CORS_ORIGIN=
